{
  "version": 2,
  "functions": {
    "api/index.js": {
      "includeFiles": "server/sql-wasm.wasm"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/((?!api/|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
